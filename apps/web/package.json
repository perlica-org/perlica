{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "codegen:openapi": "openapi-typescript ${OPENAPI_SCHEMA_URL:-http://localhost:3000/openapi.json} -o src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "@perlica/api": "workspace:*",
    "@perlica/auth": "workspace:*",
    "@perlica/env": "workspace:*",
    "@tanstack/svelte-form": "^1.33.0",
    "axios": "^1.20.0",
    "better-auth": "catalog:",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dotenv": "catalog:",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "lucide-svelte": "^1.0.1",
    "shadcn-svelte": "^1.7.0",
    "svelte-filepond": "^0.2.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
