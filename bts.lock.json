    "apps/server/package.json": "{\n  \"name\": \"server\",\n  \"main\": \"src/index.ts\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsdown\",\n    \"check-types\": \"tsc -b\",\n    \"compile\": \"bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server\",\n    \"test\": \"vitest run --passWithNoTests\",\n    \"dev\": \"bun run --hot src/index.ts\",\n    \"start\": \"bun run dist/index.mjs\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@perlica/env\": \"workspace:*\",\n    \"@perlica/api\": \"workspace:*\",\n    \"@perlica/auth\": \"workspace:*\",\n    \"hono\": \"catalog:\",\n    \"@hono/zod-openapi\": \"^1.6.3\",\n    \"@scalar/hono-api-reference\": \"^0.11.16\",\n    \"better-auth\": \"catalog:\",\n    \"@aws-sdk/client-ses\": \"^3.1146.0\",\n    \"pino\": \"^10.4.0\",\n    \"pino-http\": \"^11.0.0\",\n    \"@sentry/node\": \"^10.70.0\",\n    \"@sentry/profiling-node\": \"^10.70.0\",\n    \"@upstash/redis\": \"^1.39.0\",\n    \"@aws-sdk/client-s3\": \"^3.1146.0\",\n    \"@aws-sdk/s3-request-presigner\": \"^3.1146.0\",\n    \"@perlica/db\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"catalog:\",\n    \"tsdown\": \"^0.22.3\",\n    \"@perlica/config\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\",\n    \"vitest\": \"catalog:\",\n    \"@vitest/ui\": \"catalog:\",\n    \"@vitest/coverage-v8\": \"catalog:\",\n    \"jsdom\": \"catalog:\",\n    \"pino-pretty\": \"^13.1.3\"\n  }\n}\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"private\": true,\n  \"version\": \"0.0.1\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite dev\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"prepare\": \"svelte-kit sync || echo ''\",\n    \"check-types\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"check\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"check:watch\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch\",\n    \"test\": \"vitest run --passWithNoTests\",\n    \"codegen:openapi\": \"openapi-typescript ${OPENAPI_SCHEMA_URL:-http://localhost:3000/openapi.json} -o src/lib/api-schema.d.ts\"\n  },\n  \"devDependencies\": {\n    \"@sveltejs/adapter-auto\": \"^7.0.1\",\n    \"@sveltejs/kit\": \"^2.70.3\",\n    \"@sveltejs/vite-plugin-svelte\": \"^7.3.1\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"svelte\": \"^5.57.1\",\n    \"svelte-check\": \"^4.7.6\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"vite\": \"^8.3.2\",\n    \"typescript\": \"catalog:\",\n    \"@perlica/config\": \"workspace:*\",\n    \"alchemy\": \"catalog:\",\n    \"@sveltejs/adapter-cloudflare\": \"^7.2.9\",\n    \"openapi-typescript\": \"^7.13.0\",\n    \"vitest\": \"catalog:\",\n    \"@vitest/ui\": \"catalog:\",\n    \"@vitest/coverage-v8\": \"catalog:\",\n    \"jsdom\": \"catalog:\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/user-event\": \"^14.6.7\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/svelte\": \"^5.4.2\"\n  },\n  \"dependencies\": {\n    \"@tanstack/svelte-form\": \"^1.33.0\",\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@perlica/env\": \"workspace:*\",\n    \"@perlica/api\": \"workspace:*\",\n    \"@perlica/auth\": \"workspace:*\",\n    \"better-auth\": \"catalog:\",\n    \"filepond\": \"^4.32.12\",\n    \"filepond-plugin-image-preview\": \"^4.6.12\",\n    \"filepond-plugin-file-validate-type\": \"^1.2.9\",\n    \"filepond-plugin-file-validate-size\": \"^2.2.8\",\n    \"svelte-filepond\": \"^0.2.2\",\n    \"axios\": \"^1.20.0\",\n    \"shadcn-svelte\": \"^1.7.0\",\n    \"bits-ui\": \"^2.19.5\",\n    \"clsx\": \"^2.1.1\",\n    \"tailwind-merge\": \"^3.7.0\",\n    \"tw-animate-css\": \"^1.4.0\",\n    \"lucide-svelte\": \"^1.0.1\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"perlica\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": {\n    \"packages\": [\n      \"apps/*\",\n      \"packages/*\"\n    ],\n    \"catalog\": {\n      \"dotenv\": \"^17.4.2\",\n      \"zod\": \"^4.6.5\",\n      \"typescript\": \"^6.0.3\",\n      \"@types/bun\": \"^1.4.2\",\n      \"hono\": \"^4.12.27\",\n      \"better-auth\": \"1.6.22\",\n      \"vitest\": \"4.1.8\",\n      \"@vitest/ui\": \"4.1.8\",\n      \"@vitest/coverage-v8\": \"4.1.8\",\n      \"jsdom\": \"^29.1.1\",\n      \"alchemy\": \"^0.93.12\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"turbo dev\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"turbo -F server dev\",\n    \"db:push\": \"turbo -F @perlica/db db:push\",\n    \"db:studio\": \"turbo -F @perlica/db db:studio\",\n    \"db:generate\": \"turbo -F @perlica/db db:generate\",\n    \"db:migrate\": \"turbo -F @perlica/db db:migrate\",\n    \"test\": \"bun run --filter web test && bun run --filter server test && bun run --filter @perlica/api test\",\n    \"knip\": \"knip\",\n    \"knip:production\": \"knip --production\",\n    \"secrets:scan\": \"gitleaks git --redact --verbose\",\n    \"secrets:scan:staged\": \"gitleaks git --pre-commit --redact --staged --verbose\"\n  },\n  \"packageManager\": \"bun@1.3.5\",\n  \"overrides\": {\n    \"kysely\": \"0.28.17\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@perlica/env\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"catalog:\",\n    \"@types/bun\": \"catalog:\",\n    \"@perlica/config\": \"workspace:*\",\n    \"@cloudflare/workers-types\": \"^4.20260629.1\",\n    \"turbo\": \"2.10.11\",\n    \"knip\": \"^6.39.0\"\n  }\n}\n",
    "packages/api/package.json": "{\n  \"name\": \"@perlica/api\",\n  \"exports\": {\n    \".\": {\n      \"default\": \"./src/index.ts\"\n    },\n    \"./*\": {\n      \"default\": \"./src/*.ts\"\n    }\n  },\n  \"type\": \"module\",\n  \"scripts\": {\n    \"check-types\": \"tsc --noEmit\",\n    \"openapi:verify\": \"bun src/verify-openapi.ts\",\n    \"test\": \"vitest run --passWithNoTests\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"catalog:\",\n    \"@perlica/config\": \"workspace:*\",\n    \"vitest\": \"catalog:\",\n    \"@vitest/ui\": \"catalog:\",\n    \"@vitest/coverage-v8\": \"catalog:\",\n    \"jsdom\": \"catalog:\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@perlica/env\": \"workspace:*\",\n    \"@perlica/auth\": \"workspace:*\",\n    \"@asteasolutions/zod-to-openapi\": \"^8.5.0\",\n    \"hono\": \"catalog:\",\n    \"@perlica/db\": \"workspace:*\"\n  }\n}\n",
